# ldas.conf.example — ldas CMDB 只读连接配置模板
# 用法：复制为 ldas.conf，填好 password，并锁权限：
#     cp ldas.conf.example ldas.conf && chmod 600 ldas.conf
# sync_redis_monitoring.py 只从这一个文件读 ldas 连接信息
# （endpoint / port / user / password / database 放在一起，不再有裸密码文件）。
# password 一项也可留空、改由环境变量 LDAS_PASSWORD 注入（密管/CI 场景）。
[ldas]
host     = aws-luckyus-ldas-rw.cxwu08m2qypw.us-east-1.rds.amazonaws.com
port     = 3306
user     = luckyozono_A_o
password = CHANGME
database = luckyus_ozono

# ----- [aws] 段：可选。指定拉 ElastiCache 用的 AWS 身份 -----
# 不写这一段 → 用主机默认凭证链（instance profile / ~/.aws / 环境变量），保持现状。
# 用途：cron 主机默认身份（如 dba-downloaddblog-api）无 elasticache:DescribeReplicationGroups 时，
#       在这里指定一个有权限的身份（如 databasecheck），无需改 crontab / 环境变量。
# 二选一（优先 profile，密钥由 aws CLI 托管、不落进本文件）：
# [aws]
# profile = databasecheck            # ~/.aws/credentials 里的 profile 名（推荐）
# region  = us-east-1                # 可选，覆盖默认 us-east-1
#
# 或直接写密钥（明文落盘，仅限本 0600 文件；两者必须同时给）：
# [aws]
# access_key_id     = AKIAXXXXXXXXXXXXXXXX
# secret_access_key = CHANGEME
# region            = us-east-1
