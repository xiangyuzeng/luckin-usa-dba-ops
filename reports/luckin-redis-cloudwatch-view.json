  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "datasource",
        "label": "Prometheus 数据源",
        "query": "prometheus",
        "refresh": 1,
        "current": {
          "text": "UMBQuerier-Luckin",
          "value": "D3SA3spNk"
        },
        "regex": "",
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": []
      },
      {
        "type": "query",
        "name": "service",
        "label": "服务 (Redis 集群)",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(aws_elasticache_cpuutilization_average, cache_cluster_id)",
        "query": {
          "qryType": 1,
          "query": "label_values(aws_elasticache_cpuutilization_average, cache_cluster_id)",
          "refId": "StandardVariableQuery"
        },
        "regex": "/(.*)-\\d+$/",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "options": []
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
